{
  "name": "pi-mqtt-swarm",
  "version": "0.2.0",
  "description": "Coordinate a swarm of pi coding agents over MQTT: central orchestration, per-agent in/out queues, status overview, a shared message board, and remote model/reset/reload control.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-swarm-console": "./console.ts"
  },
  "scripts": {
    "console": "node console.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mqtt",
    "multi-agent",
    "orchestration",
    "swarm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luumo-factory/pi-mqtt-swarm.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "mqtt": "^5.15.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
